# Copy this to .env.local for local development
# On Vercel, add these in Project Settings → Environment Variables
GROQ_API_KEY_1=your_first_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here
GROQ_API_KEY_3=your_third_groq_api_key_here
GROQ_API_KEY_4=your_fourth_groq_api_key_here
GROQ_API_KEY_5=your_fifth_groq_api_key_here

# Single key fallback (optional, for simple single-key setup)
# GROQ_API_KEY=your_groq_api_key_here

# Required for authenticated AI requests and server-side quotas (see docs/security-setup.md)
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"nutriglance",...}
# FIREBASE_PROJECT_ID=nutriglance

# Additional Web Push reminder settings (server-only; see docs/reminders.md)
# VAPID_PUBLIC_KEY=generated_public_key
# VAPID_PRIVATE_KEY=generated_private_key
# VAPID_SUBJECT=mailto:your-support-email@example.com
# CRON_SECRET=generated_random_secret
