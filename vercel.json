{
  "cleanUrls": true,
  "crons": [
    { "path": "/api/reminder-cron?slot=afternoon", "schedule": "30 7 * * *" },
    { "path": "/api/reminder-cron?slot=evening", "schedule": "30 13 * * *" }
  ],
  "redirects": [
    { "source": "/nutriglance", "destination": "/dashboard", "permanent": true },
    { "source": "/nutriglance.html", "destination": "/dashboard", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/reminders", "destination": "/api/reminders" },
    { "source": "/api/reminder-cron", "destination": "/api/reminder-cron" },
    { "source": "/api/groq", "destination": "/api/groq" },
    { "source": "/dashboard", "destination": "/public/dashboard.html" },
    { "source": "/meals", "destination": "/public/meals.html" },
    { "source": "/progress", "destination": "/public/progress.html" },
    { "source": "/aichef", "destination": "/public/aichef.html" },
    { "source": "/settings", "destination": "/public/settings.html" },
    { "source": "/login", "destination": "/public/login.html" },
    { "source": "/download", "destination": "/public/download.html" },
    { "source": "/qr", "destination": "/public/qr.html" },
    { "source": "/about", "destination": "/public/about.html" },
    { "source": "/privacy", "destination": "/public/privacy.html" },
    { "source": "/privacy-policy", "destination": "/public/privacy.html" },
    { "source": "/premium", "destination": "/public/premium.html" },
    { "source": "/index", "destination": "/public/index.html" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
